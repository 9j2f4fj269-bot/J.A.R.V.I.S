# --- the brain (pick one) -------------------------------------------------
# OpenAI (or any OpenAI-compatible gateway: Groq, Together, OpenRouter, Ollama, LM Studio)
OPENAI_API_KEY=sk-...
# OPENAI_BASE_URL=http://localhost:11434/v1     # Ollama example
# JARVIS_MODEL=gpt-4o-mini

# Anthropic instead of OpenAI
# JARVIS_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# JARVIS_MODEL=claude-sonnet-4-5

# --- GitHub ---------------------------------------------------------------
# Classic PAT with `repo` (and `workflow` if you touch CI). Read-only tools work anonymously.
GITHUB_TOKEN=ghp_...

# --- optional -------------------------------------------------------------
# Better search: keyless Bing is the default. Tavily/Brave give cleaner results.
# JARVIS_SEARCH=tavily
# TAVILY_API_KEY=tvly-...
# JARVIS_SEARCH=brave
# BRAVE_API_KEY=...

# Where generated code and files live
# JARVIS_WORKSPACE=~/jarvis-workspace
# Long-term memory database
# JARVIS_MEMORY=~/.jarvis/memory.sqlite3

# Expose the run_shell tool (git, pip, tests). Off by default.
# JARVIS_ALLOW_SHELL=1

# Route requests through a proxy (helps with YouTube captions from datacenter IPs)
# HTTPS_PROXY=http://user:pass@host:port

# JARVIS_MAX_STEPS=12
# JARVIS_VERBOSE=1
